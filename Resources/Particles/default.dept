	<emitter name="fleshImpactEmitter">
		<blendMode>5</blendMode>
		<life>0</life>
		<lifeMax>50</lifeMax>
		<emissionRate>500</emissionRate>
		<initializers>
			<minMaxColor>
				<min>0.6:0.1:0.1:0.3</min>
				<max>0.6:0.1:0.1:0.0</max>
			</minMaxColor>
			<minMaxSize>
				<min>0.1</min>
				<max>0.2</max>
			</minMaxSize>
			<minMaxLife>
				<min>50</min>
				<max>200</max>
			</minMaxLife>
			<radiusPosition>
				<radius>0.1</radius>
			</radiusPosition>
			<minMaxSphereVelocity>
				<min>2</min>
				<max>10</max>
			</minMaxSphereVelocity>
		</initializers>
		<updaters>
			<color/>
			<life/>
			<velocity>
				<damping>0.2</damping>
			</velocity>
		</updaters>
	</emitter>
