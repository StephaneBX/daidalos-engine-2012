<emitters>
	<emitter name="smokeLeakEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>80</emissionRate>
		<initializers>
			<minMaxColor>
				<min>0.3:0.3:0.3:0.2</min>
				<max>0.3:0.3:0.3:0</max>
			</minMaxColor>
			<minMaxSize>
				<min>2</min>
				<max>6</max>
			</minMaxSize>
			<minMaxLife>
				<min>0</min>
				<max>8000</max>
			</minMaxLife>
			<minMaxRotation>
				<min>-45</min>
				<max>45</max>
			</minMaxRotation>
			<minMaxSphereVelocity>
				<min>1</min>
				<max>1.5</max>
			</minMaxSphereVelocity>
		</initializers>
		<updaters>
			<color/>
			<gravity>
				<vector>0:0:0.8</vector>
			</gravity>
			<life/>
			<rotation/>
			<size/>
			<velocity>
				<damping>0.05</damping>
			</velocity>
		</updaters>
	</emitter>
	<emitter name="smokeGreenEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>100</emissionRate>
		<initializers>
			<minMaxColor>
				<min>0.2:0.4:0.2:0.2</min>
				<max>0.2:0.4:0.2:0</max>
			</minMaxColor>
			<minMaxSize>
				<min>4</min>
				<max>8</max>
			</minMaxSize>
			<minMaxLife>
				<min>0</min>
				<max>5000</max>
			</minMaxLife>
			<minMaxRotation>
				<min>-45</min>
				<max>45</max>
			</minMaxRotation>
			<minMaxBoxPosition>
				<min>-10:0:-5</min>
				<max>10:0:5</max>
			</minMaxBoxPosition>
		</initializers>
		<updaters>
			<color/>
			<gravity>
				<vector>0:3:0</vector>
			</gravity>
			<life/>
			<rotation/>
			<size/>
		</updaters>
	</emitter>
</emitters>