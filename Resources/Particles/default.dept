<emitters>
	<emitter name="smokeLeakEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>80</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<color>0.3:0.3:0.3:0.2</color>
			<size>2</size>
			<minMaxLife>
				<min>0</min>
				<max>8000</max>
			</minMaxLife>
			<minMaxRotation>
				<min>-45</min>
				<max>45</max>
			</minMaxRotation>
			<linearVelocity>
				<direction>0:0:1</direction>
				<variationFactor>0</variationFactor>
				<velocityMin>0.8</velocityMin>
				<velocityMax>0.8</velocityMax>
			</linearVelocity>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.3:0.3:0.3:0.2</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.3:0.3:0.3:0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>3</value>
				</size>
				<size>
					<time>1.0</time>
					<value>8</value>
				</size>
			</sizeChange>
			<linearVelocityChange/>
			<life/>
			<rotation/>
		</updaters>
	</emitter>
	<emitter name="smokeGreenEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>100</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<minMaxLife>
				<min>0</min>
				<max>5000</max>
			</minMaxLife>
			<minMaxRotation>
				<min>-45</min>
				<max>45</max>
			</minMaxRotation>
			<minMaxBoxPosition>
				<min>-10:0:-5</min>
				<max>10:0:5</max>
			</minMaxBoxPosition>
			<linearVelocity>
				<direction>0:1:0</direction>
				<variationFactor>0</variationFactor>
				<velocityMin>2</velocityMin>
				<velocityMax>3</velocityMax>
			</linearVelocity>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.2:0.4:0.2:0.2</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.2:0.4:0.2:0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>4</value>
				</size>
				<size>
					<time>1.0</time>
					<value>8</value>
				</size>
			</sizeChange>
			<linearVelocityChange/>
			<life/>
			<rotation/>
		</updaters>
	</emitter>
	<emitter name="fogGreenEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>120</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<minMaxLife>
				<min>0</min>
				<max>4000</max>
			</minMaxLife>
			<minMaxRotation>
				<min>-45</min>
				<max>45</max>
			</minMaxRotation>
			<minMaxBoxPosition>
				<min>-10:0:-10</min>
				<max>10:0:10</max>
			</minMaxBoxPosition>
			<linearVelocity>
				<direction>0:1:0</direction>
				<variationFactor>0</variationFactor>
				<velocityMin>0.1</velocityMin>
				<velocityMax>0.1</velocityMax>
			</linearVelocity>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.2:0.4:0.2:0.2</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.2:0.4:0.2:0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>6</value>
				</size>
				<size>
					<time>1.0</time>
					<value>8</value>
				</size>
			</sizeChange>
			<linearVelocityChange/>
			<life/>
			<rotation/>
		</updaters>
	</emitter>
	<emitter name="activeTeleporterEmitter">
		<blendMode>1</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>250</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<color>0.0:0.7:0.0:0.2</color>
			<size>0.2</size>
			<minMaxLife>
				<min>2000</min>
				<max>2000</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>0</innerRadius>
				<outerRadius>1</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.2:0.2:0.7:0.0</value>
				</color>
				<color>
					<time>0.05</time>
					<value>0.2:0.2:0.7:0.4</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.2:0.2:0.7:0.0</value>
				</color>
			</colorChange>
			<life/>
		</updaters>
	</emitter>
	<emitter name="inactiveTeleporterEmitter">
		<blendMode>1</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>250</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<color>0.7:0.0:0.0:0.2</color>
			<size>0.2</size>
			<minMaxLife>
				<min>2000</min>
				<max>2000</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>0</innerRadius>
				<outerRadius>1</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.7:0.2:0.2:0.0</value>
				</color>
				<color>
					<time>0.05</time>
					<value>0.7:0.2:0.2:0.4</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.7:0.2:0.2:0.0</value>
				</color>
			</colorChange>
			<life/>
		</updaters>
	</emitter>
	
	<emitter name="fleshImpactEmitter">
		<blendMode>5</blendMode>
		<life>0</life>
		<lifeMax>50</lifeMax>
		<emissionRate>500</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<minMaxLife>
				<min>50</min>
				<max>200</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>0</innerRadius>
				<outerRadius>0.1</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.6:0.1:0.1:0.3</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.6:0.1:0.1:0.0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>0.1</value>
				</size>
				<size>
					<time>1.0</time>
					<value>0.2</value>
				</size>
			</sizeChange>
			<sphereVelocityChange>
				<velocity>
					<time>0</time>
					<velocityMin>2.0</velocityMin>
					<velocityMax>10.0</velocityMax>
				</velocity>
				<damping>0.2</damping>
			</sphereVelocityChange>
			<life/>
		</updaters>
	</emitter>
	<emitter name="environmentImpactEmitter">
		<blendMode>1</blendMode>
		<life>0</life>
		<lifeMax>50</lifeMax>
		<emissionRate>500</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<size>0.1</size>
			<minMaxLife>
				<min>50</min>
				<max>200</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>0</innerRadius>
				<outerRadius>0.1</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.5:0.5:0.2:0.4</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.5:0.5:0.2:0.0</value>
				</color>
			</colorChange>
			<sphereVelocityChange>
				<velocity>
					<time>0</time>
					<velocityMin>2.0</velocityMin>
					<velocityMax>10.0</velocityMax>
				</velocity>
				<damping>0.2</damping>
			</sphereVelocityChange>
			<life/>
		</updaters>
	</emitter>
	<emitter name="weaponSmokeEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>55</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<minMaxLife>
				<min>0</min>
				<max>3000</max>
			</minMaxLife>
			<minMaxRotation>
				<min>-45</min>
				<max>45</max>
			</minMaxRotation>
			<radiusPosition>
				<innerRadius>0</innerRadius>
				<outerRadius>0.1</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.2:0.2:0.2:0.2</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.2:0.2:0.2:0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>0.1</value>
				</size>
				<size>
					<time>1.0</time>
					<value>0.8</value>
				</size>
			</sizeChange>
			<linearVelocityChange>
				<velocity>
					<time>0</time>
					<direction>0:1:0</direction>
					<variationFactor>0.0</variationFactor>
					<velocityMin>0.1</velocityMin>
					<velocityMax>0.2</velocityMax>
				</velocity>
				<damping>0.2</damping>
			</linearVelocityChange>
			<life/>
			<rotation/>
		</updaters>
	</emitter>
	<emitter name="weaponFlashEmitter">
		<blendMode>1</blendMode>
		<life>0</life>
		<lifeMax>100</lifeMax>
		<emissionRate>250</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<size>0.7</size>
			<minMaxLife>
				<min>100</min>
				<max>100</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>0</innerRadius>
				<outerRadius>0.05</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.5:0.5:0.2:0.2</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.5:0.5:0.2:0.0</value>
				</color>
			</colorChange>
			<life/>
		</updaters>
	</emitter>
</emitters>