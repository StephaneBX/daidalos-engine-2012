<emitters>
	<emitter name="fleshImpactEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>500</emissionRate>
		<initializers>
			<color>0.6:0.1:0.1:0.3</color>
			<size>0.1</size>
			<minMaxLife>
				<min>50</min>
				<max>200</max>
			</minMaxLife>
			<minMaxRotation>
				<min>-45</min>
				<max>45</max>
			</minMaxRotation>
			<radiusPosition>
				<radius>0.1</radius>
			</radiusPosition>
			<minMaxBoxPosition>
				<min>-10:0:-10</min>
				<max>10:0:10</max>
			</minMaxBoxPosition>
			<linearVelocity>
				<direction></direction>
				<variationFactor></variationFactor>
				<velocityMin></velocityMin>
				<velocityMax></velocityMax>
			</linearVelocity>
			<sphereVelocity>
				<velocityMin></velocityMin>
				<velocityMax></velocityMax>
			</sphereVelocity>
			<circularVelocity></circularVelocity>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.6:0.1:0.1:0.3</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.6:0.1:0.1:0.0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>0.1</value>
				</size>
				<size>
					<time>1.0</time>
					<value>0.2</value>
				</size>
			</sizeChange>
			<linearVelocityChange>
				<velocity>
					<time>0</time>
					<direction>0:1:0</direction>
					<variationFactor>0.0</variationFactor>
					<velocityMin>2.0</velocityMin>
					<velocityMax>2.0</velocityMax>
				</velocity>
				<damping>0.0</damping>
			</linearVelocityChange>
			<sphereVelocityChange>
				<velocity>
					<time>0</time>
					<velocityMin>2.0</velocityMin>
					<velocityMax>2.0</velocityMax>
				</velocity>
				<damping>0.2</damping>
			</sphereVelocityChange>
			<circularVelocityChange>
				<velocity>
					<time>0</time>
					<velocityMin>2.0</velocityMin>
					<velocityMax>2.0</velocityMax>
				</velocity>
				<damping>0.2</damping>
			</circularVelocityChange>
			<life/>
			<velocity>
				<damping>0.2</damping>
			</velocity>
		</updaters>
	</emitter>
</emitters>
