	<emitter name="fountainEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>300</emissionRate>
		<ignoreGravity>false</ignoreGravity>
		<initializers>
			<minMaxRotation>
				<min>25</min>
				<max>65</max>
			</minMaxRotation>
			<minMaxLife>
				<min>2000</min>
				<max>4000</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>0.5</innerRadius>
				<outerRadius>0.5</outerRadius>
