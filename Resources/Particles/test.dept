			<rotation/>
		</updaters>
	</emitter>
	
	<emitter name="tornadoEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>30</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<minMaxRotation>
				<min>-65</min>
				<max>65</max>
			</minMaxRotation>
			<minMaxLife>
				<min>10000</min>
				<max>10000</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>2.5</innerRadius>
				<outerRadius>2.5</outerRadius>
			</radiusPosition>
