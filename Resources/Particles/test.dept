<emitters>
	<emitter name="sphereEmitter">
		<blendMode>1</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>500</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<minMaxLife>
				<min>5000</min>
				<max>8000</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>0</innerRadius>
				<outerRadius>0.1</outerRadius>
				<axis>1:1:1</axis>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.5:0.5:0.2:0.0</value>
				</color>
				<color>
					<time>0.1</time>
					<value>0.5:0.5:0.2:0.3</value>
				</color>
				<color>
					<time>0.5</time>
					<value>0.5:0.7:0.2:0.3</value>
				</color>
				<color>
					<time>1.0</time>
					<value>1.0:0.5:0.2:0.0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>0.15</value>
				</size>
			</sizeChange>
			<sphereVelocityChange>
				<velocity>
					<time>0</time>
					<velocityMin>0.25</velocityMin>
					<velocityMax>2.5</velocityMax>
				</velocity>
				<damping>0.2</damping>
			</sphereVelocityChange>
			<life/>
		</updaters>
	</emitter>
	
	<emitter name="liftEmitter">
