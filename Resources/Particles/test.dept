				<innerRadius>2.5</innerRadius>
				<outerRadius>2.5</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.7:0.4:0.4:0.0</value>
				</color>
				<color>
					<time>0.05</time>
					<value>0.7:0.4:0.4:0.4</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.7:0.4:0.4:0.0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>0.2</value>
				</size>
			</sizeChange>
			<linearVelocityChange>
				<velocity>
					<time>0</time>
					<direction>0:1:0</direction>
					<velocityMin>1</velocityMin>
					<velocityMax>1</velocityMax>
					<variationFactor>0</variationFactor>
				</velocity>
				<damping>0.0</damping>
			</linearVelocityChange>
			<circularVelocityChange>
				<velocity>
					<time>0</time>
					<velocityMin>1</velocityMin>
					<velocityMax>1</velocityMax>
				</velocity>
				<damping>0.0</damping>
			</circularVelocityChange>
			<life/>
		</updaters>
	</emitter>
	
	<emitter name="fireworkEmitter">
		<blendMode>1</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>700</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<minMaxLife>
				<min>6000</min>
				<max>6000</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>0.5</innerRadius>
				<outerRadius>0.5</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.7:0.7:0.4:0.4</value>
				</color>
				<color>
					<time>0.5</time>
					<value>0.7:0.7:0.7:0.4</value>
				</color>
				<color>
					<time>0.8</time>
					<value>0.4:0.7:0.4:0.4</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.4:0.7:0.7:0.0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>0.2</value>
				</size>
				<size>
					<time>0.5</time>
					<value>0.2</value>
				</size>
				<size>
					<time>0.7</time>
					<value>0.5</value>
				</size>
			</sizeChange>
			<linearVelocityChange>
				<velocity>
					<time>0</time>
					<direction>0.2:0.8:0</direction>
					<velocityMin>10</velocityMin>
					<velocityMax>10</velocityMax>
					<variationFactor>0</variationFactor>
				</velocity>
				<velocity>
					<time>0.5</time>
					<direction>0.2:0.8:0</direction>
					<velocityMin>0</velocityMin>
					<velocityMax>0</velocityMax>
					<variationFactor>0</variationFactor>
				</velocity>
				<damping>0.3</damping>
			</linearVelocityChange>
			<sphereVelocityChange>
				<velocity>
					<time>0.5</time>
					<velocityMin>3</velocityMin>
					<velocityMax>6</velocityMax>
				</velocity>
				<damping>0.2</damping>
			</sphereVelocityChange>
			<life/>
		</updaters>
	</emitter>
	
	<emitter name="fireSmokeEmitter">
		<blendMode>5</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>35</emissionRate>
		<ignoreGravity>true</ignoreGravity>
