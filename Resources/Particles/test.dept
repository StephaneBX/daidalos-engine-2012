<emitters>
	<emitter name="sphereEmitter">
		<blendMode>1</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>500</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<minMaxLife>
				<min>500</min>
				<max>5000</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>0.1</innerRadius>
				<outerRadius>0.1</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.5:0.5:0.2:0.0</value>
				</color>
				<color>
					<time>0.1</time>
					<value>0.5:0.5:0.2:0.4</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.8:0.5:0.2:0.0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>0.15</value>
				</size>
			</sizeChange>
			<sphereVelocityChange>
				<velocity>
					<time>0</time>
					<velocityMin>0.25</velocityMin>
					<velocityMax>1.5</velocityMax>
				</velocity>
				<damping>0.2</damping>
			</sphereVelocityChange>
			<life/>
		</updaters>
	</emitter>
	
	<emitter name="liftEmitter">
		<blendMode>1</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>1300</emissionRate>
		<ignoreGravity>true</ignoreGravity>
		<initializers>
			<minMaxLife>
				<min>3000</min>
				<max>10000</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>2.5</innerRadius>
				<outerRadius>2.5</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.4:0.4:0.7:0.0</value>
				</color>
				<color>
					<time>0.05</time>
					<value>0.4:0.4:0.7:0.4</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.4:0.4:0.7:0.0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>0.2</value>
				</size>
			</sizeChange>
			<linearVelocityChange>
				<velocity>
					<time>0</time>
					<direction>0:1:0</direction>
					<velocityMin>1</velocityMin>
					<velocityMax>2</velocityMax>
					<variationFactor>0</variationFactor>
				</velocity>
				<damping>0.0</damping>
			</linearVelocityChange>
			<life/>
		</updaters>
	</emitter>
	
	<emitter name="circularEmitter">
		<blendMode>1</blendMode>
		<life>-1</life>
		<lifeMax>-1</lifeMax>
		<emissionRate>1000</emissionRate>
