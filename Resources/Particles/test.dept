				</color>
				<color>
					<time>0.05</time>
					<value>0.6:0.6:0.6:0.08</value>
				</color>
				<color>
					<time>0.6</time>
					<value>0.6:0.6:0.6:0.05</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.6:0.6:0.6:0.0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>3.5</value>
