					<velocityMax>5</velocityMax>
					<variationFactor>0</variationFactor>
				</velocity>
				<damping>0.0</damping>
			</linearVelocityChange>
			<circularVelocityChange>
				<velocity>
					<time>0</time>
					<velocityMin>5</velocityMin>
					<velocityMax>10</velocityMax>
				</velocity>
				<damping>0.0</damping>
