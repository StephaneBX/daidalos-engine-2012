				<min>0</min>
				<max>8000</max>
			</minMaxLife>
			<radiusPosition>
				<innerRadius>1.5</innerRadius>
				<outerRadius>1.5</outerRadius>
			</radiusPosition>
		</initializers>
		<updaters>
			<colorChange>
				<color>
					<time>0.0</time>
					<value>0.6:0.6:0.6:0.0</value>
				</color>
				<color>
					<time>0.4</time>
					<value>0.6:0.6:0.6:0.02</value>
				</color>
				<color>
					<time>1.0</time>
					<value>0.6:0.6:0.6:0</value>
				</color>
			</colorChange>
			<sizeChange>
				<size>
					<time>0.0</time>
					<value>0.4</value>
				</size>
				<size>
					<time>1.0</time>
					<value>14.0</value>
				</size>
			</sizeChange>
			<linearVelocityChange>
				<velocity>
					<time>0</time>
					<direction>0:1:0</direction>
					<velocityMin>0.5</velocityMin>
					<velocityMax>1.0</velocityMax>
					<variationFactor>0.3</variationFactor>
				</velocity>
				<damping>0.0</damping>
			</linearVelocityChange>
			<life/>
		</updaters>
	</emitter>
	
