#version 130
precision highp float;

uniform float viewDistance;
uniform float fogFalloff;
uniform float materialNs;
uniform vec3 materialDiffuse;
uniform vec3 materialAmbient;
uniform vec3 materialSpecular;
uniform vec3 materialEmission;
uniform sampler2D textureSampler0;

smooth in vec2 out_texcoord;
smooth in vec3 out_normal;
smooth in float depth;

out vec4 diffuseRT;  // Diffuse + Fog factor
out vec4 normalRT;   // Normal
out vec4 specularRT; // Specular + Ns
out float depthRT;   // Linear depth

void main()
{
	float fogFactor = depth >= (viewDistance * fogFalloff) ? clamp(1.0f - (((depth / viewDistance) - fogFalloff) / (1.0f - fogFalloff)), 0.0f, 1.0f) : 1.0f;

	diffuseRT = vec4(texture(textureSampler0, out_texcoord).xyz, fogFactor);
	normalRT = vec4((out_normal + 1.0) / 2.0, 1.0);
	specularRT = vec4(materialSpecular, materialNs / 128.0f);
	depthRT = depth / viewDistance;
}
