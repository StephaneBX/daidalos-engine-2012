#version 130
precision highp float;

uniform vec4 cameraPositionDistance;
uniform vec4 directionalLightDirection;
uniform vec4 directionalLightColor;

uniform sampler2D textureSampler0;
uniform sampler2D textureSampler1;
uniform sampler2D textureSampler2;

smooth in vec2 out_texcoord;
smooth in vec3 out_viewDistance;

out vec4 lightRT;

void main()
{
	lightRT.w = 1;
	
	vec3 normal = (texture(textureSampler0, out_texcoord).xyz * 2) - 1.0f;
	vec3 currentPosition = cameraPositionDistance.xyz + (texture(textureSampler2, out_texcoord).r * out_viewDistance);
	vec4 specularNs = texture(textureSampler1, out_texcoord);

	vec3 diffuse = directionalLightColor.xyz * clamp(dot(directionalLightDirection.xyz, normal), 0.0f, 1.0f);
	vec3 specular = specularNs.xyz * directionalLightColor.xyz * pow(clamp(dot(normalize(reflect(directionalLightDirection.xyz, normal)), normalize(currentPosition.xyz - cameraPositionDistance.xyz)), 0.0f, 1.0f), specularNs.w * 128.0f);
	
	lightRT.xyz = clamp(diffuse + specular, 0.0f, 1.0f);
}
