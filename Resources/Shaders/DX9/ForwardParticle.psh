uniform float viewDistance;
uniform float fogFalloff;

struct VS_OUTPUT {
	float4 position 		: POSITION;
	float2 texcoord 		: TEXCOORD0;
	float  depth			: TEXCOORD1;
	float4 color	  		: COLOR0;
};

struct PS_OUTPUT {
	float4 color : COLOR;
};

sampler2D albedo;

PS_OUTPUT main(VS_OUTPUT IN)
{
	PS_OUTPUT OUT;
	
	float fogFactor = IN.depth >= (viewDistance * fogFalloff) ? saturate(1.0f - (((IN.depth / viewDistance) - fogFalloff) / (1.0f - fogFalloff))) : 1.0f;

	float4 currentDiffuse = tex2D(albedo, IN.texcoord.xy) * IN.color * fogFactor;

	OUT.color = currentDiffuse;
	
	return OUT;
}