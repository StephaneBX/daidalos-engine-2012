uniform float alphaFactor;

struct PS_INPUT {
	float4 position 	: POSITION;
	float2 texcoord		: TEXCOORD0;
};

struct PS_OUTPUT {
	float4 color 	: COLOR;
};

sampler2D textureSampler;

PS_OUTPUT main(PS_INPUT IN) {
	PS_OUTPUT OUT;
	
	float4 textureColor = tex2D(textureSampler, IN.texcoord);
	OUT.color.rgb = textureColor.rgb;
	OUT.color.a = alphaFactor;
	
	return OUT;
}
