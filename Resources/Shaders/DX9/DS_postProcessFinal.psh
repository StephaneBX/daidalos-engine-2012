struct PS_INPUT {
	float4 position 	: POSITION;
	float2 texcoord		: TEXCOORD0;
};

struct PS_OUTPUT {
	float4 color 	: COLOR;
};

sampler2D postProcessSampler;

PS_OUTPUT main(PS_INPUT IN) {
	PS_OUTPUT OUT;
	
	float4 postProcess = tex2D(postProcessSampler, IN.texcoord);
	OUT.color = postProcess;
	
	return OUT;
}
