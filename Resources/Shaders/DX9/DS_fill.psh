uniform float viewDistance;
uniform float fogFalloff;
uniform float materialNs;
uniform float3 materialDiffuse;
uniform float3 materialAmbient;
uniform float3 materialSpecular;
uniform float3 materialEmission;

struct PS_INPUT
{
	float4 position 	: POSITION;
	float2 texcoord		: TEXCOORD0;
	float3 normal 		: TEXCOORD1;
	float  depth		: TEXCOORD2;
};

struct PS_OUTPUT
{
	float4 diffuse 	: COLOR0; // Diffuse + Fog factor
	float4 normal 	: COLOR1; // Normal
	float4 specular : COLOR2; // Specular + Ns
	float4 depth 	: COLOR3; // Linear depth
};

sampler2D diffuseSampler;

PS_OUTPUT main(PS_INPUT IN)
{
	PS_OUTPUT OUT;
	
	float fogFactor = IN.depth >= (viewDistance * fogFalloff) ? saturate(1.0f - (((IN.depth / viewDistance) - fogFalloff) / (1.0f - fogFalloff))) : 1.0f;
	
	OUT.diffuse = float4(tex2D(diffuseSampler, IN.texcoord).xyz, fogFactor);
	OUT.normal = float4((IN.normal + 1) / 2.0, 1);
	OUT.specular = float4(materialSpecular, materialNs / 128.0f);
	OUT.depth = IN.depth / viewDistance;
	
	return OUT;
}


