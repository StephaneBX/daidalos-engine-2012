#define EPSILON 0.0005f

uniform float viewDistance;
uniform float fogFalloff;

uniform float materialNs;
uniform float3 materialDiffuse;
uniform float3 materialAmbient;
uniform float3 materialSpecular;
uniform float3 materialEmission;

uniform float4x4 spotLightViewProj;
uniform float4 cameraPositionDistance;
uniform float4 spotLightPosition;
uniform float4 spotLightDirection;
uniform float4 spotLightRRFT;
uniform float4 spotLightColor;
uniform float shadowMapSize;
uniform int shadowCaster;

struct PS_INPUT {
	float4 position 	: POSITION;
	float4 world 		: TEXCOORD0;
	float2 texcoord		: TEXCOORD1;
	float3 normal 		: TEXCOORD2;
	float3 tangent 		: TEXCOORD3;
	float3 binormal		: TEXCOORD4;
	float  depth		: TEXCOORD5;
};

struct PS_OUTPUT {
	float4 color : COLOR;
};

sampler2D diffuseSampler;
sampler2D normalSampler;
sampler2D lightDepthSampler;

float spotDistanceFactor(float distance) {
	float result;
	
	if(distance >= spotLightRRFT.x) {
		result = 0;
	} else {
		if(distance > spotLightRRFT.x * spotLightRRFT.z) {
			result = 1 - ((distance - (spotLightRRFT.x * spotLightRRFT.z)) / ((1 - spotLightRRFT.z) * spotLightRRFT.x));
		} else {
			result = 1;
		}
	}
	return result;
}

float spotTightnessFactor(float angle) {	
	float result;
	
	if(angle > spotLightRRFT.y * spotLightRRFT.w) {
		result = 1 - ((angle - (spotLightRRFT.y * spotLightRRFT.w)) / ((1 - spotLightRRFT.w) * spotLightRRFT.y));
	} else {
		result = 1;
	}
	return result;
}

PS_OUTPUT main(PS_INPUT IN) {
	PS_OUTPUT OUT;
	OUT.color = float4(0,0,0,1);
	
	float angle = degrees(acos(dot(normalize(spotLightPosition.xyz - IN.world.xyz), -spotLightDirection.xyz)));
	float fogFactor = IN.depth >= (viewDistance * fogFalloff) ? saturate(1.0f - (((IN.depth / viewDistance) - fogFalloff) / (1.0f - fogFalloff))) : 1.0f;
	
	if(angle >= 0 && angle < spotLightRRFT.y && distance(IN.world.xyz, spotLightPosition.xyz) <= spotLightRRFT.x) {
	
		float3 diffuseMap = tex2D(diffuseSampler, IN.texcoord).xyz;
		float3 normalMap = normalize((tex2D(normalSampler, IN.texcoord).xyz * 2.0f) - 1.0f);
		float3x3 TBN = transpose(float3x3(IN.tangent, IN.binormal, IN.normal));
		float3 normal = normalize(mul(TBN, normalMap));
		
		float shadowTerm = 0.0f;
		if(shadowCaster) {
			float fTexelSize = 1.0f / shadowMapSize;
		
			float4 camToLight = mul(float4(IN.world.xyz, 1.0f), spotLightViewProj);
			float2 shadowTexC = (camToLight.xy / camToLight.w) * float2(0.5f, -0.5f) + float2(0.5f + fTexelSize / 2.0f, 0.5f + fTexelSize / 2.0f);
			
			if(saturate(shadowTexC.x) == shadowTexC.x && saturate(shadowTexC.y) == shadowTexC.y) {
				// Soft-edged shadows
				float2 vTexCoords[9];
				vTexCoords[0] = shadowTexC;
				vTexCoords[1] = shadowTexC + float2(-fTexelSize, 0.0f);
				vTexCoords[2] = shadowTexC + float2(fTexelSize, 0.0f);
				vTexCoords[3] = shadowTexC + float2(0.0f, -fTexelSize);
				vTexCoords[6] = shadowTexC + float2(0.0f,  fTexelSize);
				vTexCoords[4] = shadowTexC + float2(-fTexelSize, -fTexelSize);
				vTexCoords[5] = shadowTexC + float2(fTexelSize, -fTexelSize);
				vTexCoords[7] = shadowTexC + float2(-fTexelSize,  fTexelSize);
				vTexCoords[8] = shadowTexC + float2(fTexelSize,  fTexelSize);
				
				float depth = (camToLight.z / camToLight.w) - EPSILON;
				for(int i = 0; i < 9; i++)
					  shadowTerm += tex2D(lightDepthSampler, vTexCoords[i]).r < depth ? 0.0f : 1.0f;
				shadowTerm /= 9.0f;
			}	
		} else {
			shadowTerm = 1.0f;
		}
		
		if(shadowTerm > 0.0f) {
			float3 L = normalize(IN.world.xyz - spotLightPosition.xyz);
			float3 R = reflect(-L, normal);
			float3 E = normalize(cameraPositionDistance.xyz - IN.world.xyz);
			float3 V = normalize(-E);
			
			float3 diffuse = diffuseMap.xyz * materialDiffuse.xyz * spotLightColor.xyz * saturate(dot(normal, -L)) * spotDistanceFactor(distance(IN.world.xyz, spotLightPosition.xyz)) * spotTightnessFactor(angle);
			float3 specular = materialSpecular.xyz * spotLightColor.xyz * pow(saturate(dot(R, V)), materialNs) * spotDistanceFactor(distance(IN.world.xyz, spotLightPosition.xyz)) * spotTightnessFactor(angle);
			
			OUT.color.xyz = saturate(diffuse + specular) * shadowTerm * fogFactor;
		}
	}
	
	return OUT;
}
